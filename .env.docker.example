# ==============================================================================
# UK3P Application - Docker Production Environment (.env)
# ==============================================================================

# APP CONFIGURATION
APP_NAME="Web UK3P"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://your-domain.com

# HTTP PORT (default 80, ganti jika port 80 dipakai oleh reverse proxy seperti Nginx Hostinger)
HTTP_PORT=80

# AUTO MIGRATE ON STARTUP (set true untuk migrasi otomatis saat container start)
AUTO_MIGRATE=false

# LOG CONFIGURATION
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# DATABASE CONFIGURATION (Sesuai dengan service 'db' di docker-compose.yml)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=uk3p_db
DB_USERNAME=uk3p_user
DB_PASSWORD=GantiPasswordUserDatabase123!
DB_ROOT_PASSWORD=GantiPasswordRootDatabase123!

# BROADCAST / CACHE / QUEUE / SESSION
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# WHATSAPP NOTIFIER MICROSERVICE
# URL ke container whatsapp-notifier di dalam network Docker
WHATSAPP_MICROSERVICE_URL=http://whatsapp-notifier:4001
WA_NOTIFIER_PORT=4001
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_NOTIFICATION_TEMPLATE_NAME=

# FIREBASE CONFIGURATION (Untuk Realtime Chat)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=
FIREBASE_UNIVERSE_DOMAIN=googleapis.com

# MAIL CONFIGURATION (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

